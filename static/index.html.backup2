<!doctype html><html lang="ru"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>МГУ • Расписание</title><script src="https://telegram.org/js/telegram-web-app.js"></script>
<link rel="stylesheet" href="/static/style.css"></head><body>
<div class="glow"></div><header><div><div class="eyebrow">МОСКОВСКИЙ ГОСУДАРСТВЕННЫЙ УНИВЕРСИТЕТ</div><h1>Расписание</h1><p id="date"></p></div><img src="/static/mgu.png" class="crest"></header>
<section class="toolbar"><select id="group"></select><div class="week"><button id="prev">‹</button><span id="weekLabel">Текущая неделя</span><button id="next">›</button></div></section>
<nav id="days"></nav><main id="schedule"></main>
<script src="/static/app.js"></script></body></html>
