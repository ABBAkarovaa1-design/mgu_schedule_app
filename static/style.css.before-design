@import url("https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&display=swap");
@import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap");
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

ц:root {
  --bg: #0f0f0f;
  --surface: #181818;
  --surface-hover: #202020;
  --border: #303030;

  --text: #f5f3f1;
  --muted: #969390;

  --accent: #8d183d;
  --accent-hover: #a51f49;

  --radius: 14px;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100vh;

  max-width: 820px;
  margin-left: auto;
  margin-right: auto;

  padding: 28px 22px 60px;

  background: var(--bg);
  color: var(--text);

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Display",
    "SF Pro Text",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 15px;
  line-height: 1.45;

  -webkit-font-smoothing: antialiased;
}

/* HEADER */

header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  padding: 10px 0 44px;
}

.eyebrow {
  margin: 0 0 10px;

  color: var(--muted);

  font-size: 11px;
  font-weight: 600;

  letter-spacing: 0.14em;
  text-transform: uppercase;
}
h1 {
  margin: 0;
  color: #ffffff;

  font-family: "Inter", sans-serif;
  font-size: 42px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: -0.045em;

  animation: titleIn 0.7s cubic-bezier(.22,1,.36,1) both;
}


.header p {
  margin: 14px 0 0;

  color: var(--muted);

  font-size: 14px;
}

/* EMBLEM */

.crest {
  width: 74px;
  height: 74px;

  object-fit: contain;

  display: block;

  opacity: 1;
  filter: none;
}

/* CONTROLS */

.toolbar {
  display: grid;

  grid-template-columns: minmax(0, 1fr) auto;

  gap: 10px;

  margin-bottom: 12px;
}

select {
  width: 100%;
  min-height: 48px;
  padding: 0 15px;

  background: #181818 !important;
  color: #f5f5f5 !important;

  border: 1px solid #363636 !important;
  border-radius: 11px;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 14px;
  font-weight: 500;

  opacity: 1 !important;
  box-shadow: none !important;
}

.week {
  display: flex;
  align-items: center;

  padding: 4px;
}

.week button {
  width: 40px;
  height: 38px;

  border: 0;
  border-radius: 8px;

  background: #242424;
  color: #ffffff;

  font-size: 20px;
  font-weight: 600;

  cursor: pointer;
}

.week button:hover {
  background: var(--accent);
  color: #ffffff;
}

/* DAYS */

#days {
  display: flex;

  gap: 6px;

  overflow-x: auto;

  padding: 8px 0 22px;

  scrollbar-width: none;
}

#days::-webkit-scrollbar {
  display: none;
}

#days button {
  flex: 0 0 auto;

  padding: 9px 14px;

  background: #181818;

  border: 1px solid #303030;
  border-radius: 9px;

  color: #d8d6d4;

  font: inherit;
  font-size: 13px;
  font-weight: 600;

  cursor: pointer;
}

#days button:hover {
  background: #242424;

  border-color: #444444;

  color: #ffffff;
}

#days button.active {
  background: var(--accent);

  border-color: var(--accent);

  color: #ffffff;
}

/* SCHEDULE */

main {
  display: grid;

  gap: 8px;
}

.card {
  display: grid;

  grid-template-columns: 92px 1fr;

  gap: 18px;

  padding: 18px 20px;

  background: var(--surface);

  border: 1px solid var(--border);

  border-radius: var(--radius);
}

.card:hover {
  background: var(--surface-hover);

  border-color: #3b3b3b;
}

.time {
  padding-top: 2px;

  color: #c12b5d;

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 0.02em;
}

.subject {
  margin: 0 0 7px;

  color: var(--text);

  font-size: 17px;
  font-weight: 650;

  line-height: 1.25;

  letter-spacing: -0.02em;
}

.meta {
  color: var(--muted);

  font-size: 13px;

  line-height: 1.5;
}

/* CURRENT LESSON */

.now {
  border-color: var(--accent);

  box-shadow:
    inset 3px 0 0 var(--accent);
}

/* EMPTY */

.empty {
  padding: 70px 20px;

  color: var(--muted);

  text-align: center;

  font-size: 14px;
}

/* MOBILE */

@media (max-width: 600px) {

  body {
    padding: 20px 15px 40px;
  }

  header {
    padding-bottom: 34px;
  }
  h1 {
  margin: 0;
  color: #ffffff;

  font-family:
    "Helvetica Neue",
    Arial,
    sans-serif;

  font-size: 42px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: -0.045em;

  animation: titleIn 0.7s cubic-bezier(.22,1,.36,1) both;
}

@keyframes titleIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


  .crest {
    width: 58px;
    height: 58px;
  }

  .toolbar {
    grid-template-columns: 1fr;
  }

  .week {
    justify-content: space-between;
  }

  .card {
    grid-template-columns: 72px 1fr;

    gap: 12px;

    padding: 16px;
  }

  .subject {
    font-size: 16px;
  }
}

@media (max-width: 380px) {

  h1 {
    font-size: 36px;
  }

  .card {
    grid-template-columns: 1fr;

    gap: 4px;
  }

  .time {
    padding-top: 0;
  }
}

/* Эстетичный заголовок */
h1 {
  margin: 0;
  color: #f5f5f5;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 42px;
  line-height: 1.05;
  font-weight: 500;
  letter-spacing: -0.045em;
}

/* Подпись университета */
.eyebrow {
  margin-bottom: 10px;

  color: #8f8f8f;

  font-size: 10px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

/* Дни недели */
#days button {
  min-width: 48px;
  height: 42px;

  padding: 0 13px;

  border: 1px solid #2b2b2b;
  border-radius: 10px;

  background: #181818;
  color: #8f8f8f;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;

  opacity: 1;
}

#days button:hover {
  background: #202020;
  color: #ffffff;
}

#days button.active {
  background: #8f183f;
  border-color: #8f183f;
  color: #ffffff;
}

/* Кнопка выбора группы — полностью непрозрачная */
select {
  background: #181818 !important;
  color: #f2f2f2 !important;
  border: 1px solid #363636 !important;
  opacity: 1 !important;
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 14px;
  font-weight: 500;
}

select option {
  background: #181818;
  color: #f2f2f2;
}

/* Заголовок */
h1 {
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 40px !important;
  line-height: 1.05 !important;
  font-weight: 500 !important;
  letter-spacing: -0.035em !important;
  color: #ffffff !important;
  opacity: 1 !important;
  text-shadow: none !important;
}

/* Пустое состояние выбора группы */
#group {
  background-color: #181818 !important;
  color: #f5f5f5 !important;
  border: 1px solid #363636 !important;
  opacity: 1 !important;
  -webkit-appearance: none;
  appearance: none;
}

#group:disabled {
  background-color: #181818 !important;
  color: #f5f5f5 !important;
  opacity: 1 !important;
}

/* Текст внутри списка */
#group option {
  background-color: #181818 !important;
  color: #f5f5f5 !important;
}

/* ─────────────────────────────
   Финальная типографика
   ───────────────────────────── */

h1 {
  font-family:
    "Helvetica Neue",
    "Arial",
    sans-serif !important;

  font-size: 44px !important;
  line-height: 0.98 !important;
  font-weight: 400 !important;
  letter-spacing: -0.055em !important;

  color: #f7f7f7 !important;
  margin: 2px 0 8px !important;

  text-shadow: none !important;
}

/* Маленький университетский лейбл */
.eyebrow {
  font-family:
    "Helvetica Neue",
    Arial,
    sans-serif;

  font-size: 9px !important;
  font-weight: 600 !important;
  letter-spacing: 0.18em !important;

  color: #8c8c8c !important;
}

/* ─────────────────────────────
   Плавные кнопки
   ───────────────────────────── */

button,
select {
  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    color 180ms ease,
    transform 140ms ease,
    box-shadow 180ms ease;
}

/* Дни недели */
#days button {
  cursor: pointer;
  transform: translateY(0);
}

#days button:hover {
  background: #242424 !important;
  border-color: #454545 !important;
  color: #ffffff !important;
  transform: translateY(-1px);
}

#days button:active {
  transform: translateY(1px) scale(0.97);
}

#days button.active {
  background: #8f183f !important;
  border-color: #8f183f !important;
  color: #ffffff !important;
  box-shadow: 0 4px 14px rgba(143, 24, 63, 0.22);
}

/* Стрелки недели */
.week button {
  cursor: pointer;
}

.week button:hover {
  background: #303030 !important;
  color: #ffffff !important;
  transform: scale(1.04);
}

.week button:active {
  transform: scale(0.94);
}

/* Выбор группы */
#group:hover {
  border-color: #555555 !important;
}

#group:focus {
  outline: none;
  border-color: #8f183f !important;
  box-shadow: 0 0 0 3px rgba(143, 24, 63, 0.12);
}

/* ─────────────────────────────
   Появление карточек расписания
   ───────────────────────────── */

.card {
  animation: scheduleCardIn 320ms ease both;
}

@keyframes scheduleCardIn {
  from {
    opacity: 0;
    transform: translateY(7px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Уважение системной настройки */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

