const tg = window.Telegram?.WebApp;
tg?.ready();
tg?.expand();

const days = ["ПН", "ВТ", "СР", "ЧТ", "ПТ", "СБ", "ВС"];

let groupId = null;
let week = 0;
let data = {};
let selected = new Date().getDay();

selected = selected === 0 ? 6 : selected - 1;

const group = document.querySelector("#group");
const nav = document.querySelector("#days");
const main = document.querySelector("#schedule");
const wl = document.querySelector("#weekLabel");

document.querySelector("#date").textContent =
  new Intl.DateTimeFormat("ru-RU", {
    dateStyle: "long"
  }).format(new Date());

/* Дни недели */
days.forEach((day, i) => {
  const button = document.createElement("button");

  button.textContent = day;

  button.onclick = () => {
    selected = i;
    renderDays();
    render();
  };

  nav.append(button);
});

function renderDays() {
  [...nav.children].forEach((button, i) => {
    button.classList.toggle("active", i === selected);
  });
}

/* Определяем время */
function minutes(time) {
  if (!time) return 0;

  const [h, m] = time.split(":").map(Number);
  return h * 60 + m;
}

/* Текущая дата */
function todayIndex() {
  const day = new Date().getDay();
  return day === 0 ? 6 : day - 1;
}

/* Определяем статус пары */
function getLessonState(lesson) {
  const now = new Date();

  const current = now.getHours() * 60 + now.getMinutes();

  const start = minutes(lesson.start);
  const end = minutes(lesson.end);

  if (
    selected === todayIndex() &&
    current >= start &&
    current < end
  ) {
    return "current";
  }

  if (
    selected === todayIndex() &&
    current < start
  ) {
    return "next";
  }

  return "";
}

/* Загрузка групп */
async function init() {
  try {
    const gs = await fetch("/api/groups").then(r => r.json());

    group.innerHTML = gs.length
      ? gs
          .map(
            g =>
              `<option value="${g.id}">
                ${g.name}${g.faculty ? " — " + g.faculty : ""}
              </option>`
          )
          .join("")
      : `<option value="">Нет групп</option>`;

    if (gs.length) {
      groupId = gs[0].id;
      await load();
    } else {
      render();
    }
  } catch (error) {
    main.innerHTML =
      `<div class="empty">Не удалось загрузить группы</div>`;
  }
}

/* Загрузка расписания */
async function load() {
  groupId = Number(group.value);

  if (!groupId) {
    render();
    return;
  }

  main.classList.add("loading");

  try {
    data = await fetch(
      `/api/schedule/${groupId}?week=${week}`
    ).then(r => r.json());

    updateWeekLabel();
    render();
  } catch (error) {
    main.innerHTML =
      `<div class="empty">Не удалось загрузить расписание</div>`;
  }

  setTimeout(() => {
    main.classList.remove("loading");
  }, 150);
}

/* Название недели */
function updateWeekLabel() {
  if (week === 0) {
    wl.textContent = "Текущая неделя";
  } else if (week > 0) {
    wl.textContent = `+${week} нед.`;
  } else {
    wl.textContent = `${week} нед.`;
  }
}

/* Рендер расписания */
function render() {
  const list = data[days[selected]] || [];

  if (!list.length) {
    main.innerHTML =
      `<div class="empty">
        <div class="empty-icon">○</div>
        <div>В этот день занятий нет</div>
      </div>`;

    return;
  }

  main.innerHTML = list
    .map((lesson, index) => {
      const state = getLessonState(lesson);

      return `
        <article
          class="card ${state}"
          style="--delay:${index * 70}ms"
        >
          <div class="lesson-number">
            ${String(index + 1).padStart(2, "0")}
          </div>

          <div class="lesson-content">

            <div class="lesson-top">
              <div class="time">
                ${esc(lesson.start)} — ${esc(lesson.end)}
              </div>

              ${
                state === "current"
                  ? `<div class="status current-status">
                      <span></span> СЕЙЧАС
                    </div>`
                  : state === "next"
                  ? `<div class="status">СЛЕДУЮЩАЯ</div>`
                  : ""
              }
            </div>

            <div class="subject">
              ${esc(lesson.subject)}
            </div>

            <div class="meta">
              ${lesson.teacher ? `👨‍🏫 ${esc(lesson.teacher)}` : ""}
              ${
                lesson.room
                  ? ` <span class="dot">·</span> 📍 ${esc(lesson.room)}`
                  : ""
              }
            </div>

            ${
              lesson.lesson_type
                ? `<div class="lesson-type">
                    ${esc(lesson.lesson_type)}
                  </div>`
                : ""
            }

          </div>
        </article>
      `;
    })
    .join("");
}

/* Экранирование текста */
function esc(value) {
  return String(value ?? "").replace(
    /[&<>"']/g,
    char =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      })[char]
  );
}

/* Смена группы */
group.onchange = load;

/* Предыдущая неделя */
document.querySelector("#prev").onclick = async () => {
  week--;
  await load();
};

/* Следующая неделя */
document.querySelector("#next").onclick = async () => {
  week++;
  await load();
};

renderDays();
init();

