:root {
  --bg: #0b0b0c;
  --surface: #151516;
  --surface-2: #1b1b1d;
  --border: #2a2a2d;

  --text: #f5f3f1;
  --muted: #929095;

  --accent: #8f183f;
  --accent-hover: #a51e4a;
  --accent-soft: #241118;

  --radius: 14px;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100vh;

  background: var(--bg);
  color: var(--text);

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Helvetica Neue",
    Arial,
    sans-serif;

  -webkit-font-smoothing: antialiased;
}

button,
select {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.page {
  width: min(920px, 100%);
  margin: 0 auto;
  padding: 30px 22px 50px;
}

/* =========================
   HEADER
========================= */

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;

  min-height: 120px;

  animation: headerIn 0.5s ease both;
}

.header-copy {
  min-width: 0;
}

.eyebrow {
  margin-bottom: 12px;

  color: #929095;

  font-size: 10px;
  line-height: 1;
  font-weight: 600;

  letter-spacing: 0.17em;
  text-transform: uppercase;
}

h1 {
  margin: 0;

  color: #f7f4f2;

  font-family: "Lora", Georgia, serif;

  font-size: 42px;
  line-height: 1.05;
  font-weight: 500;

  letter-spacing: -0.035em;
}

#date {
  margin: 9px 0 0;

  color: var(--muted);

  font-size: 13px;
  font-weight: 400;
}

.crest {
  width: 82px;
  height: 82px;

  object-fit: contain;

  flex: 0 0 auto;

  animation: crestIn 0.55s cubic-bezier(.2,.8,.2,1) both;
}

.header-line {
  width: 100%;
  height: 1px;

  margin: 20px 0 22px;

  background: #29292c;
}

/* =========================
   TOOLBAR
========================= */

.toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.8fr);
  gap: 18px;

  margin-bottom: 20px;
}

.group-wrap label {
  display: block;

  margin: 0 0 8px;

  color: #77767b;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.select-wrap {
  position: relative;
}

select#group {
  appearance: none;
  -webkit-appearance: none;

  display: block;

  width: 100%;
  min-height: 48px;

  padding: 0 44px 0 15px;

  background: #18181a !important;

  color: #f5f3f1 !important;

  border: 1px solid #343438 !important;
  border-radius: 12px;

  opacity: 1 !important;

  box-shadow: none !important;

  cursor: pointer;

  font-size: 14px;
  font-weight: 500;

  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    transform 0.15s ease;
}

select#group:hover {
  background-color: #202023 !important;
  border-color: #4a4a4f !important;
}

select#group:focus {
  outline: none;

  background-color: #18181a !important;

  border-color: var(--accent) !important;

  box-shadow:
    0 0 0 2px rgba(143, 24, 63, 0.18) !important;
}

select#group option {
  background: #18181a !important;
  color: #f5f3f1 !important;
}

.select-arrow {
  position: absolute;

  right: 16px;
  top: 50%;

  transform: translateY(-55%);

  color: #a7a5aa;

  pointer-events: none;

  font-size: 18px;
}

/* =========================
   WEEK
========================= */

.week-wrap {
  display: flex;
  align-items: flex-end;
}

.week-title {
  display: grid;
  grid-template-columns: 42px 1fr 42px;
  align-items: center;

  width: 100%;
  min-height: 48px;

  border: 1px solid #2d2d30;
  border-radius: 12px;

  background: #141416;
}

.week-center {
  text-align: center;
}

#weekLabel {
  color: #eeeeed;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 0.12em;
  text-transform: uppercase;
}

#weekDates {
  display: block;

  margin-top: 4px;

  color: #77767b;

  font-size: 10px;
}

.arrow-btn {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 34px;
  height: 34px;

  margin: auto;

  border: 0;
  border-radius: 8px;

  background: #202023;
  color: #d9d7d5;

  cursor: pointer;

  font-size: 23px;
  line-height: 1;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.15s ease;
}

.arrow-btn:hover {
  background: #2a2a2d;
  color: white;
}

.arrow-btn:active {
  transform: scale(0.91);
}

/* =========================
   DAYS
========================= */

.days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 7px;

  margin-bottom: 24px;
}

.days button {
  min-width: 0;
  height: 42px;

  padding: 0 6px;

  border: 1px solid #2b2b2e;
  border-radius: 10px;

  background: #18181a;
  color: #85848a;

  cursor: pointer;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 0.05em;

  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.15s ease;
}

.days button:hover {
  background: #222225;
  border-color: #414146;
  color: #eeeeee;
  transform: translateY(-1px);
}

.days button:active {
  transform: translateY(1px) scale(0.97);
}

.days button.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #ffffff;

  box-shadow: 0 5px 18px rgba(143, 24, 63, 0.18);
}

/* =========================
   SCHEDULE
========================= */

.schedule {
  display: flex;
  flex-direction: column;
  gap: 10px;

  min-height: 120px;
}

.card {
  position: relative;

  display: grid;
  grid-template-columns: 48px 150px 1fr;
  gap: 18px;
  align-items: center;

  padding: 17px 18px;

  background: var(--surface);

  border: 1px solid #29292c;
  border-radius: var(--radius);

  overflow: hidden;

  animation: cardIn 0.42s cubic-bezier(.2,.8,.2,1) both;

  transition:
    border-color 0.2s ease,
    background-color 0.2s ease,
    transform 0.2s ease;
}

.card:hover {
  background: #19191b;
  border-color: #3a3a3e;
  transform: translateY(-2px);
}

.card::before {
  content: "";

  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 2px;

  background: var(--accent);
}

.lesson-number {
  color: #55545a;

  font-size: 20px;
  font-weight: 600;

  letter-spacing: -0.04em;
}

.time {
  color: var(--accent);

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 0.02em;
}

.lesson-main {
  min-width: 0;
}

.subject {
  color: #f4f2f0;

  font-size: 16px;
  line-height: 1.3;
  font-weight: 600;
}

.meta {
  margin-top: 7px;

  color: #85848a;

  font-size: 12px;
  line-height: 1.55;
}

.now-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  width: fit-content;

  margin-bottom: 7px;
  padding: 4px 7px;

  background: var(--accent-soft);

  border: 1px solid rgba(143, 24, 63, 0.65);
  border-radius: 6px;

  color: #dca1b4;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0.12em;
}

.now-badge::before {
  content: "";

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #c84670;

  animation: pulse 1.5s ease-in-out infinite;
}

.progress {
  height: 3px;

  margin-top: 11px;

  background: #28282b;

  border-radius: 99px;

  overflow: hidden;
}

.progress-bar {
  height: 100%;

  background: var(--accent);

  border-radius: inherit;

  transition: width 0.5s ease;
}

.empty {
  padding: 55px 20px;

  text-align: center;

  border: 1px solid #252528;
  border-radius: var(--radius);

  background: #121214;

  animation: cardIn 0.4s ease both;
}

.empty-line {
  width: 55px;
  height: 1px;

  margin: 0 auto 18px;

  background: var(--accent);
}

.empty-title {
  color: #e9e7e5;

  font-family: "Lora", Georgia, serif;

  font-size: 20px;
}

.empty-subtitle {
  margin-top: 7px;

  color: #77767b;

  font-size: 11px;
}

/* =========================
   FOOTER
========================= */

.footer {
  margin-top: 45px;
  padding-top: 18px;

  border-top: 1px solid #242427;

  color: #66656a;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 0.16em;
}

.footer span {
  display: block;

  margin-top: 7px;

  color: #454449;

  font-size: 8px;
  font-weight: 500;
}

/* =========================
   ANIMATIONS
========================= */

@keyframes headerIn {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes crestIn {
  from {
    opacity: 0;
    transform: scale(0.88);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.45;
    transform: scale(0.9);
  }

  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

/* =========================
   MOBILE
========================= */

@media (max-width: 650px) {
  .page {
    padding: 22px 14px 38px;
  }

  .header {
    min-height: 100px;
  }

  h1 {
    font-size: 36px;
  }

  .crest {
    width: 64px;
    height: 64px;
  }

  .toolbar {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .days {
    gap: 5px;
  }

  .days button {
    height: 40px;
    font-size: 10px;
  }

  .card {
    grid-template-columns: 38px 1fr;
    gap: 12px;

    padding: 16px;
  }

  .lesson-number {
    grid-row: span 2;
  }

  .time {
    grid-column: 2;
  }

  .lesson-main {
    grid-column: 2;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* =========================================
   НОВЫЕ КАРТОЧКИ РАСПИСАНИЯ
   ========================================= */

#schedule {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

#schedule.loading {
  opacity: 0.55;
  transform: translateY(3px);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.card {
  position: relative;

  display: flex;
  gap: 16px;

  padding: 17px 18px;

  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);

  overflow: hidden;

  animation: cardAppear 0.45s cubic-bezier(.2,.8,.2,1) both;
  animation-delay: var(--delay);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  border-color: #3a3a3d;
  background: var(--surface-2);
}

.card::before {
  content: "";

  position: absolute;
  left: 0;
  top: 12px;
  bottom: 12px;

  width: 2px;

  background: var(--border);
  border-radius: 2px;
}

.card.current {
  border-color: var(--accent);
  background:
    linear-gradient(
      110deg,
      var(--accent-soft),
      var(--surface)
    );

  box-shadow:
    0 8px 30px rgba(143, 24, 63, 0.12);
}

.card.current::before {
  background: var(--accent);
}

.lesson-number {
  flex: 0 0 28px;

  padding-top: 3px;

  color: var(--accent);

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.lesson-content {
  min-width: 0;
  flex: 1;
}

.lesson-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;

  margin-bottom: 7px;
}

.time {
  color: var(--accent);

  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.subject {
  color: var(--text);

  font-size: 17px;
  line-height: 1.3;
  font-weight: 600;
}

.meta {
  margin-top: 7px;

  color: var(--muted);

  font-size: 12px;
  line-height: 1.5;
}

.dot {
  color: #555;
  padding: 0 3px;
}

.lesson-type {
  display: inline-block;

  margin-top: 9px;
  padding: 4px 8px;

  border-radius: 6px;

  background: #202024;
  color: #8f8f94;

  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.status {
  flex-shrink: 0;

  color: #77777d;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.current-status {
  color: #c83263;
}

.current-status span {
  display: inline-block;

  width: 5px;
  height: 5px;

  margin-right: 3px;

  border-radius: 50%;
  background: #c83263;

  animation: pulseDot 1.6s ease-in-out infinite;
}

.empty {
  padding: 50px 20px;

  text-align: center;

  color: var(--muted);

  font-size: 13px;
}

.empty-icon {
  margin-bottom: 10px;

  color: var(--accent);

  font-size: 24px;
}

/* =========================================
   АНИМАЦИИ
   ========================================= */

@keyframes cardAppear {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulseDot {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.4;
    transform: scale(0.75);
  }
}

/* =========================================
   ДНИ НЕДЕЛИ
   ========================================= */

#days button {
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease;
}

#days button:hover {
  transform: translateY(-1px);
}

#days button.active {
  transform: translateY(-1px);
  box-shadow: 0 5px 14px rgba(143, 24, 63, 0.22);
}

/* =========================================
   МОБИЛЬНАЯ ВЕРСИЯ
   ========================================= */

@media (max-width: 420px) {
  .card {
    gap: 12px;
    padding: 15px;
  }

  .lesson-number {
    flex-basis: 23px;
    font-size: 10px;
  }

  .subject {
    font-size: 16px;
  }

  .time {
    font-size: 11px;
  }
}

