@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');

:root {
  --bg: #0b0b0c;
  --surface: #151516;
  --surface-2: #1b1b1d;
  --surface-3: #222224;

  --border: #2d2d30;

  --text: #f4f2f3;
  --muted: #8d8a8d;

  --accent: #8f183f;
  --accent-hover: #a51e4a;
  --accent-soft: #32111f;

  --radius: 16px;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 85% 0%,
      rgba(143, 24, 63, 0.14),
      transparent 28%
    ),
    var(--bg);

  color: var(--text);

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Helvetica Neue",
    Arial,
    sans-serif;

  padding: 22px;
}

body > * {
  max-width: 780px;
  margin-left: auto;
  margin-right: auto;
}

/* =========================
   HEADER
   ========================= */

header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  padding: 12px 2px 26px;

  animation: headerAppear 0.7s ease both;
}

.eyebrow {
  margin-bottom: 9px;

  color: #777477;

  font-size: 10px;
  line-height: 1;

  font-weight: 600;

  letter-spacing: 0.17em;
  text-transform: uppercase;
}

/* Главный заголовок */

h1 {
  margin: 0;

  color: #f7f5f6;

  font-family:
    Lora,
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(36px, 8vw, 52px);
  line-height: 1.05;

  font-weight: 500;

  letter-spacing: -0.035em;
}

header p {
  margin: 10px 0 0;

  color: var(--muted);

  font-size: 13px;
  line-height: 1.4;
}

/* Эмблема */

.crest {
  width: 72px;
  height: 72px;

  object-fit: contain;

  filter:
    drop-shadow(0 8px 20px rgba(0, 0, 0, 0.45));

  animation: crestAppear 0.8s cubic-bezier(.2,.8,.2,1) both;
}

/* =========================
   TOOLBAR
   ========================= */

.toolbar {
  display: grid;
  grid-template-columns: 1fr auto;

  gap: 10px;

  margin-bottom: 14px;

  animation: fadeUp 0.55s 0.12s ease both;
}

/* Выбор группы */

select {
  width: 100%;
  min-height: 48px;

  padding: 0 15px;

  border: 1px solid var(--border);
  border-radius: 12px;

  background: #181819 !important;
  color: #f1eff0 !important;

  font-family: Inter, sans-serif;
  font-size: 14px;
  font-weight: 500;

  opacity: 1 !important;

  outline: none;

  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}

select:hover {
  border-color: #454548;
  background: #1d1d1f !important;
}

select:focus {
  border-color: var(--accent);
}

/* =========================
   WEEK SWITCHER
   ========================= */

.week {
  display: flex;
  align-items: center;
  gap: 4px;

  min-height: 48px;

  padding: 4px;

  background: #181819;

  border: 1px solid var(--border);
  border-radius: 12px;
}

.week button {
  width: 40px;
  height: 38px;

  border: 0;
  border-radius: 9px;

  background: #242426;
  color: #f2f2f2;

  font-size: 18px;

  cursor: pointer;

  transition:
    background 0.2s ease,
    transform 0.18s ease,
    color 0.2s ease;
}

.week button:hover {
  background: var(--accent);
  transform: translateY(-2px);
}

.week button:active {
  transform: translateY(0) scale(0.94);
}

/* =========================
   DAYS
   ========================= */

#days {
  display: flex;
  gap: 7px;

  overflow-x: auto;

  padding: 3px 0 16px;

  scrollbar-width: none;

  animation: fadeUp 0.55s 0.2s ease both;
}

#days::-webkit-scrollbar {
  display: none;
}

#days button {
  flex: 0 0 auto;

  min-width: 48px;
  height: 42px;

  padding: 0 13px;

  border: 1px solid #2b2b2d;
  border-radius: 10px;

  background: #181819;
  color: #858286;

  font-family: Inter, sans-serif;

  font-size: 12px;
  font-weight: 600;

  letter-spacing: 0.05em;

  cursor: pointer;

  opacity: 1;

  transition:
    background 0.22s ease,
    border-color 0.22s ease,
    color 0.22s ease,
    transform 0.18s ease;
}

#days button:hover {
  background: #232325;
  color: #ffffff;
  transform: translateY(-2px);
}

#days button:active {
  transform: translateY(0) scale(0.95);
}

#days button.active {
  background: var(--accent);
  border-color: var(--accent);

  color: #ffffff;

  box-shadow:
    0 5px 18px rgba(143, 24, 63, 0.25);
}

/* =========================
   SCHEDULE
   ========================= */

main {
  display: grid;
  gap: 10px;
}

/* Карточка занятия */

.card {
  position: relative;

  overflow: hidden;

  padding: 16px 17px;

  background: linear-gradient(
    145deg,
    #1c1c1e,
    #151516
  );

  border: 1px solid #29292c;
  border-radius: var(--radius);

  animation: cardAppear 0.45s cubic-bezier(.2,.8,.2,1) both;

  transition:
    transform 0.22s ease,
    border-color 0.22s ease,
    background 0.22s ease;
}

.card::before {
  content: "";

  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 3px;

  background: var(--accent);

  transform: scaleY(0.65);

  transition: transform 0.25s ease;
}

.card:hover {
  transform: translateY(-2px);

  border-color: #3a3034;

  background: #1d1d1f;
}

.card:hover::before {
  transform: scaleY(1);
}

.time {
  margin-bottom: 5px;

  color: #d65b86;

  font-size: 12px;

  font-weight: 700;

  letter-spacing: 0.03em;
}

.subject {
  margin: 0 0 7px;

  color: #f5f3f4;

  font-size: 18px;

  font-weight: 650;

  letter-spacing: -0.02em;
}

.meta {
  color: #89868a;

  font-size: 13px;

  line-height: 1.6;
}

/* Пустой день */

.empty {
  padding: 65px 20px;

  text-align: center;

  color: #777478;

  font-size: 14px;

  animation: fadeUp 0.45s ease both;
}

/* Текущее занятие */

.now {
  border-color: var(--accent);

  box-shadow:
    0 0 0 1px rgba(143, 24, 63, 0.45),
    0 12px 35px rgba(143, 24, 63, 0.12);
}

/* =========================
   ANIMATIONS
   ========================= */

@keyframes headerAppear {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes crestAppear {
  from {
    opacity: 0;
    transform: translateY(-8px) scale(0.88);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes cardAppear {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================
   MOBILE
   ========================= */

@media (max-width: 560px) {

  body {
    padding: 17px;
  }

  header {
    padding-bottom: 22px;
  }

  .crest {
    width: 62px;
    height: 62px;
  }

  .toolbar {
    grid-template-columns: 1fr;
  }

  .week {
    justify-content: space-between;
  }

  h1 {
    font-size: 38px;
  }
}

/* =========================
   REDUCED MOTION
   ========================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Жёстко фиксируем непрозрачный select */
.toolbar select,
select#group {
  appearance: none !important;
  -webkit-appearance: none !important;

  background-color: #181819 !important;
  background-image: none !important;

  color: #f4f2f3 !important;

  border: 1px solid #363638 !important;

  opacity: 1 !important;

  box-shadow: none !important;

  -webkit-text-fill-color: #f4f2f3 !important;
}

.toolbar select:hover,
select#group:hover {
  background-color: #202022 !important;
  border-color: #49494c !important;
}

.toolbar select:focus,
select#group:focus {
  background-color: #181819 !important;
  border-color: #8f183f !important;
  outline: none !important;
}

.toolbar select option,
select#group option {
  background-color: #181819 !important;
  color: #f4f2f3 !important;
  opacity: 1 !important;
}

