@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap');

:root {
  --bg: #0b0b0c;
  --surface: #161618;
  --surface-2: #1c1c1f;
  --surface-3: #242427;

  --border: #2d2d30;

  --text: #f5f3f4;
  --muted: #858287;
  --muted-light: #aaa7aa;

  --accent: #8f183f;
  --accent-hover: #a51f4b;
  --accent-soft: #32101f;

  --radius: 15px;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 85% 0%,
      rgba(143, 24, 63, 0.12),
      transparent 28%
    ),
    var(--bg);

  color: var(--text);

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Helvetica Neue",
    Arial,
    sans-serif;

  padding: 22px;
}

.page {
  width: 100%;
  max-width: 780px;

  margin: 0 auto;
}


/* =========================
   HEADER
   ========================= */

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  padding: 12px 2px 25px;

  animation:
    fade-up 0.65s
    cubic-bezier(.2,.8,.2,1)
    both;
}

.eyebrow {
  margin-bottom: 9px;

  color: #747176;

  font-size: 10px;
  line-height: 1;

  font-weight: 600;

  letter-spacing: .17em;

  text-transform: uppercase;
}

h1 {
  margin: 0;

  color: #f5f3f4;

  font-family:
    Lora,
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(38px, 8vw, 52px);

  font-weight: 500;

  line-height: 1.04;

  letter-spacing: -.04em;
}

.header p {
  margin: 10px 0 0;

  color: var(--muted);

  font-size: 13px;
}

.crest {
  width: 72px;
  height: 72px;

  object-fit: contain;

  filter:
    drop-shadow(
      0 8px 20px rgba(0,0,0,.5)
    );

  animation:
    crest-in
    .7s
    cubic-bezier(.2,.8,.2,1)
    both;
}


/* =========================
   HEADER LINE
   ========================= */

.header-line {
  height: 1px;

  margin-bottom: 17px;

  background: #27272a;

  position: relative;

  animation:
    line-in
    .7s
    .15s
    ease
    both;
}

.header-line span {
  display: block;

  width: 65px;
  height: 1px;

  background: var(--accent);
}


/* =========================
   TOOLBAR
   ========================= */

.toolbar {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    auto;

  gap: 10px;

  margin-bottom: 14px;

  animation:
    fade-up
    .55s
    .12s
    ease
    both;
}


/* GROUP */

.group-field {
  min-width: 0;
}

.group-field label {
  display: block;

  margin: 0 0 7px 2px;

  color: #747176;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .16em;

  text-transform: uppercase;
}

.select-wrap {
  position: relative;
}

select {
  appearance: none !important;
  -webkit-appearance: none !important;

  display: block;

  width: 100%;
  height: 48px;

  padding:
    0 42px
    0 15px;

  border:
    1px solid #363638;

  border-radius: 11px;

  background-color: #181819 !important;
  background-image: none !important;

  color: #f4f2f3 !important;

  font-family: Inter, sans-serif;

  font-size: 14px;

  font-weight: 500;

  opacity: 1 !important;

  outline: none;

  box-shadow: none !important;

  -webkit-text-fill-color: #f4f2f3 !important;

  cursor: pointer;

  transition:
    border-color .2s ease,
    background-color .2s ease,
    transform .2s ease;
}

select:hover {
  background-color: #202022 !important;

  border-color: #49494c !important;
}

select:focus {
  background-color: #181819 !important;

  border-color: var(--accent) !important;
}

select option {
  background-color: #181819 !important;

  color: #f4f2f3 !important;
}

.select-arrow {
  position: absolute;

  top: 50%;
  right: 16px;

  transform:
    translateY(-55%);

  color: #aaa7aa;

  font-size: 18px;

  pointer-events: none;
}


/* =========================
   WEEK
   ========================= */

.week {
  display: flex;

  align-items: center;

  gap: 4px;

  min-width: 220px;

  height: 48px;

  margin-top: 18px;

  padding: 4px;

  background: #181819;

  border:
    1px solid #2d2d30;

  border-radius: 11px;
}

.week button {
  flex: 0 0 38px;

  width: 38px;
  height: 38px;

  border: 0;

  border-radius: 8px;

  background: #242426;

  color: #f3f1f2;

  font-size: 20px;

  cursor: pointer;

  transition:
    background .2s ease,
    transform .18s ease;
}

.week button:hover {
  background: var(--accent);

  transform:
    translateY(-1px);
}

.week button:active {
  transform:
    scale(.94);
}

.week-info {
  flex: 1;

  text-align: center;

  line-height: 1.15;
}

#weekLabel {
  color: #e9e7e8;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .08em;
}

#weekDates {
  display: block;

  margin-top: 4px;

  color: #777478;

  font-size: 9px;
}


/* =========================
   DAYS
   ========================= */

#days {
  display: flex;

  gap: 7px;

  overflow-x: auto;

  padding:
    3px
    0
    17px;

  scrollbar-width: none;

  animation:
    fade-up
    .55s
    .2s
    ease
    both;
}

#days::-webkit-scrollbar {
  display: none;
}

#days button {
  flex: 0 0 auto;

  min-width: 48px;

  height: 42px;

  padding:
    0 13px;

  border:
    1px solid #2d2d30;

  border-radius: 10px;

  background: #181819;

  color: #858287;

  font-family: Inter, sans-serif;

  font-size: 12px;

  font-weight: 600;

  letter-spacing: .05em;

  cursor: pointer;

  transition:
    background .22s ease,
    border-color .22s ease,
    color .22s ease,
    transform .18s ease;
}

#days button:hover {
  background: #242426;

  color: #fff;

  transform:
    translateY(-2px);
}

#days button:active {
  transform:
    scale(.95);
}

#days button.active {
  background: var(--accent);

  border-color: var(--accent);

  color: #fff;

  box-shadow:
    0 7px 20px
    rgba(143,24,63,.25);

  transform:
    translateY(-1px);
}


/* =========================
   SCHEDULE
   ========================= */

main {
  display: grid;

  gap: 10px;
}


/* =========================
   CARD
   ========================= */

.card {
  position: relative;

  display: grid;

  grid-template-columns: 38px 1fr;

  overflow: hidden;

  padding: 16px 17px 16px 14px;

  background:
    linear-gradient(
      145deg,
      #1c1c1e,
      #151516
    );

  border:
    1px solid #29292c;

  border-radius: var(--radius);

  animation:
    card-in
    .45s
    var(--delay)
    cubic-bezier(.2,.8,.2,1)
    both;

  transition:
    transform .22s ease,
    border-color .22s ease,
    background .22s ease,
    box-shadow .22s ease;
}

.card::before {
  content: "";

  position: absolute;

  top: 0;
  bottom: 0;
  left: 0;

  width: 3px;

  background: var(--accent);

  transform:
    scaleY(.45);

  transition:
    transform .25s ease;
}

.card:hover {
  transform:
    translateY(-2px);

  border-color:
    #3b3437;

  box-shadow:
    0 10px 28px
    rgba(0,0,0,.18);
}

.card:hover::before {
  transform:
    scaleY(1);
}


/* NUMBER */

.lesson-number {
  padding-top: 2px;

  color: #575459;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .05em;
}


/* CONTENT */

.lesson-content {
  min-width: 0;
}

.time {
  margin-bottom: 5px;

  color: #d45b85;

  font-size: 12px;

  font-weight: 700;

  letter-spacing: .03em;
}

.subject {
  margin-bottom: 8px;

  color: #f5f3f4;

  font-size: 18px;

  font-weight: 600;

  line-height: 1.25;

  letter-spacing: -.02em;
}

.meta {
  display: flex;

  flex-wrap: wrap;

  gap: 5px 13px;

  color: #858287;

  font-size: 12px;

  line-height: 1.5;
}

.meta span {
  position: relative;
}

.meta span:not(:last-child)::after {
  content: "";

  position: absolute;

  right: -8px;
  top: 50%;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: #555256;

  transform:
    translateY(-50%);
}


/* =========================
   NOW
   ========================= */

.now {
  border-color:
    var(--accent);

  box-shadow:
    0 0 0 1px
    rgba(143,24,63,.35),

    0 12px 32px
    rgba(143,24,63,.13);
}

.now::before {
  transform:
    scaleY(1);
}

.now-label {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  margin-bottom: 7px;

  padding:
    4px 7px;

  background:
    var(--accent-soft);

  border-radius: 5px;

  color: #df7297;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: .11em;
}

.now-label span {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #d45b85;

  box-shadow:
    0 0 0 3px
    rgba(212,91,133,.1);

  animation:
    pulse 1.5s
    ease-in-out
    infinite;
}


/* =========================
   EMPTY
   ========================= */

.empty {
  padding:
    70px 20px;

  text-align: center;

  color: #777478;

  font-size: 14px;

  animation:
    fade-up
    .4s
    ease
    both;
}

.empty-mark {
  margin-bottom: 10px;

  color: var(--accent);

  font-size: 22px;
}


/* =========================
   FOOTER
   ========================= */

.footer {
  padding:
    50px
    2px
    20px;

  text-align: center;
}

.footer-line {
  width: 45px;

  height: 1px;

  margin:
    0 auto
    15px;

  background: var(--accent);
}

.footer-title {
  color: #777478;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .18em;
}

.footer-subtitle {
  margin-top: 7px;

  color: #454347;

  font-size: 8px;

  letter-spacing: .12em;
}


/* =========================
   ANIMATIONS
   ========================= */

@keyframes fade-up {

  from {
    opacity: 0;

    transform:
      translateY(12px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0);
  }

}

@keyframes crest-in {

  from {
    opacity: 0;

    transform:
      translateY(-9px)
      scale(.88);
  }

  to {
    opacity: 1;

    transform:
      translateY(0)
      scale(1);
  }

}

@keyframes line-in {

  from {
    opacity: 0;

    transform:
      scaleX(.2);

    transform-origin: left;
  }

  to {
    opacity: 1;

    transform:
      scaleX(1);

    transform-origin: left;
  }

}

@keyframes card-in {

  from {
    opacity: 0;

    transform:
      translateY(12px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0);
  }

}

@keyframes pulse {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: .45;
  }

}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 560px) {

  body {
    padding: 17px;
  }

  .header {
    padding-bottom: 22px;
  }

  .crest {
    width: 62px;
    height: 62px;
  }

  .toolbar {
    grid-template-columns: 1fr;
  }

  .week {
    margin-top: 0;

    width: 100%;
  }

  h1 {
    font-size: 39px;
  }

  .card {
    grid-template-columns: 31px 1fr;

    padding-right: 14px;
  }

  .subject {
    font-size: 17px;
  }

}


/* =========================
   REDUCED MOTION
   ========================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {

    animation-duration: .01ms !important;

    animation-iteration-count: 1 !important;

    transition-duration: .01ms !important;
  }

}
